{% extends 'base.html.twig' %}
{% block title %}{{ topic.name }} — WatchLess{% endblock %}
{% block body %}
<a class="back-link" href="{{ path('topic_index') }}">← Mes sujets</a>
<section class="page-heading"><p class="eyebrow">SYNTHÈSE MULTI-VIDÉOS · {{ topic.intentLabel }}</p><h1>{{ topic.name }}</h1><p>{{ topic.description }}</p></section>
<section class="reading-panel"><h2>Ajouter une vidéo à ce sujet</h2><form method="post" action="{{ path('topic_update', {id: topic.id}) }}" class="topic-form"><input type="hidden" name="_token" value="{{ csrf_token('topic-' ~ topic.id) }}"><input type="hidden" name="action" value="import"><label for="video-url">Lien YouTube</label><input id="video-url" name="url" type="url" required maxlength="2048" placeholder="https://www.youtube.com/watch?v=…"><button type="submit">Ajouter et analyser la vidéo</button><p class="form-hint">La vidéo, sa transcription et son compte rendu seront accessibles dans ce sujet.</p></form></section>
<section class="reading-panel"><details><summary>Modifier le sujet et personnaliser la synthèse</summary>
<form method="post" action="{{ path('topic_update', {id: topic.id}) }}" class="topic-form"><input type="hidden" name="_token" value="{{ csrf_token('topic-' ~ topic.id) }}"><input type="hidden" name="action" value="edit">
<label for="name">Nom du sujet</label><input id="name" name="name" value="{{ topic.name }}" required maxlength="200">
<label for="intent">Intention du sujet</label><select id="intent" name="intent">{% for value, label in topicIntents %}<option value="{{ value }}"{% if topic.intent == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select>
<label for="description">Périmètre du sujet</label><textarea id="description" name="description" maxlength="2000" rows="3">{{ topic.description }}</textarea>
<label for="context">Votre contexte ou vos questions (facultatif)</label><textarea id="context" name="context" maxlength="2000" rows="3" placeholder="Ex. Je souhaite comparer les outils pour une petite équipe.">{{ topic.context }}</textarea>
<button class="button" type="submit">Enregistrer</button></form></details></section>
<section class="reading-panel"><h2>Vidéos du sujet</h2><p>Retirer une vidéo du sujet la conserve dans votre bibliothèque.</p>
{% for video in topic.videos %}<div class="topic-video"><div><a href="{{ path('video_show', {id: video.id, topic: topic.id}) }}">[V{{ video.id }}] {{ video.title ?? video.youtubeId }}</a><p class="muted">{{ video.status.label }}</p></div>
<form method="post" action="{{ path('topic_update', {id: topic.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('topic-' ~ topic.id) }}"><input type="hidden" name="action" value="remove"><input type="hidden" name="video_id" value="{{ video.id }}"><button class="button button-secondary" type="submit" aria-label="Retirer {{ video.title ?? video.youtubeId }} du sujet">Retirer du sujet</button></form></div>{% else %}<p class="muted">Aucune vidéo pour le moment.</p>{% endfor %}
{% if available %}<details><summary>Réutiliser une vidéo déjà analysée ou importée</summary><form method="post" action="{{ path('topic_update', {id: topic.id}) }}" class="topic-form"><input type="hidden" name="_token" value="{{ csrf_token('topic-' ~ topic.id) }}"><input type="hidden" name="action" value="add"><label for="video_id">Vidéo existante</label><select id="video_id" name="video_id" required>{% for video in available %}<option value="{{ video.id }}">{{ video.title ?? video.youtubeId }} — {{ video.status.label }}</option>{% endfor %}</select><button class="button" type="submit">Ajouter au sujet</button></form></details>{% endif %}
</section>
<section class="progress-box" {% if topic.hasWorkInProgress %}data-status-url="{{ path('topic_status', {id: topic.id}) }}" data-status="{{ topic.progressKey }}"{% endif %}><h2>Générer la synthèse du sujet</h2><p>Ajoutez vos vidéos au fil du temps. Quand votre sélection est prête et les analyses terminées, lancez le compte rendu global avec le bouton ci-dessous. Aucun ajout ne déclenche automatiquement cette synthèse.</p><p role="status">{{ topic.statusLabel }}</p>
{% if topic.busy %}<p>La synthèse des transcriptions originales continue en arrière-plan. Vous pouvez quitter cette page.</p>{% endif %}{% if topic.hasWorkInProgress %}<small data-poll-message>Le traitement continue en arrière-plan. Les statuts se mettent à jour automatiquement.</small>{% endif %}
{% if topic.errorMessage %}<p class="error" role="alert">{{ topic.errorMessage }}</p>{% endif %}
{% if topic.stale %}<p>L’ancienne synthèse ci-dessous correspond à une sélection ou un contexte antérieur. Relancez la génération pour l’actualiser.</p>{% endif %}
{% if topic.generationError %}<p>{{ topic.generationError }}</p>{% endif %}
<form method="post" action="{{ path('topic_update', {id: topic.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('topic-' ~ topic.id) }}"><input type="hidden" name="action" value="generate"><button class="button" type="submit" {% if topic.busy or topic.generationError %}disabled{% endif %}>{{ topic.summary ? 'Régénérer le compte rendu global' : 'Générer le compte rendu global' }}</button></form></section>
<section class="reading-panel" id="summary"><h2>Compte rendu global</h2><p class="muted">Synthèse automatique à relire, fondée en priorité sur les transcriptions originales des vidéos. Les références permettent de revenir aux sources ; elles ne constituent pas une vérification des affirmations.</p>{% if topic.summary %}<div class="prose">{{ topic.summary|safe_markdown }}</div><h3>Sources de cette synthèse</h3><ul>{% for source in topic.summarySources %}<li>[V{{ source.id }}] <a href="{{ source.url }}" target="_blank" rel="noopener noreferrer">{{ source.title }} ↗</a></li>{% endfor %}</ul>{% else %}<p class="muted">Ajoutez au moins deux vidéos analysées, puis lancez la synthèse pour croiser leurs transcriptions.</p>{% endif %}</section>
{% if topic.summary and not topic.stale %}<section class="reading-panel" id="publications"><h2>Préparer une publication</h2><p class="muted">Générez une version adaptée à votre canal. Chaque format est indépendant : une erreur n’empêche pas les autres publications.</p><div class="publication-actions">{% for format, label in publicationFormats %}<form method="post" action="{{ path('topic_update', {id: topic.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('topic-' ~ topic.id) }}"><input type="hidden" name="action" value="publish"><input type="hidden" name="format" value="{{ format }}"><button class="button" type="submit">{{ label }}</button></form>{% endfor %}</div>
{% for publication in topic.publications %}<article class="publication-card"><h3>{{ publication.label }}</h3><p class="muted">{% if publication.status == 'pending' %}En attente{% elseif publication.status == 'generating' %}Génération en cours…{% elseif publication.status == 'completed' %}Prêt à relire{% elseif publication.status == 'failed' %}Échec{% else %}Pas encore généré{% endif %}</p>{% if publication.errorMessage %}<p class="error" role="alert">{{ publication.errorMessage }}</p>{% endif %}{% if publication.content %}<textarea class="publication-output" readonly rows="12" aria-label="{{ publication.label }}">{{ publication.content }}</textarea>{% endif %}</article>{% endfor %}</section>{% endif %}
{% endblock %}
