<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>{% block title %}WatchLess — Comprendre, sans tout regarder{% endblock %}</title>
    <link rel="stylesheet" href="/styles.css?v=20260926-publications">
    <script src="/app.js" defer></script>
</head>
<body>
<a class="skip-link" href="#main">Aller au contenu</a>
<header class="site-header"><nav class="container nav" aria-label="Navigation principale">
    <a href="{{ path('home') }}" class="brand"><span class="brand-icon" aria-hidden="true">w.</span>WatchLess</a>
    <a href="{{ path('home') }}" class="nav-link">Mes sujets</a>
    <a href="{{ path('video_index') }}" class="nav-link">Toutes les vidéos</a>
</nav></header>
<main id="main" class="container">{% for message in app.flashes('success') %}<p class="progress-box" role="status">{{ message }}</p>{% endfor %}{% for message in app.flashes('error') %}<p class="error" role="alert">{{ message }}</p>{% endfor %}{% block body %}{% endblock %}</main>
<footer class="container footer">Moins de vidéo. Plus de compréhension.<span>Votre bibliothèque personnelle</span></footer>
</body>
</html>
