APP_ENV=dev
APP_SECRET=watchless-development-only-change-me
DEFAULT_URI=http://127.0.0.1:8000
DATABASE_URL="sqlite:///%kernel.project_dir%/var/watchless_%kernel.environment%.db"
LOCK_DSN=flock
YTDLP_BINARY=yt-dlp
YTDLP_JS_RUNTIME=node
YTDLP_TIMEOUT=1800
YTDLP_COOKIES_FILE=
SUBTITLE_LANGUAGES=fr,en
FFMPEG_BINARY=ffmpeg
TRANSCRIPTION_PROVIDER=local
WHISPER_BINARY=whisper
WHISPER_MODEL=base
WHISPER_TIMEOUT=14400
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_OUTPUT_TOKENS=6000
LLM_TOKEN_PARAMETER=max_completion_tokens
LLM_REASONING_EFFORT=
LLM_TIMEOUT=1800
LLM_CLOUD_ENABLED=0
LLM_CLOUD_BASE_URL=https://api.openai.com/v1
LLM_CLOUD_API_KEY=
LLM_CLOUD_MODEL=
LLM_CLOUD_MAX_OUTPUT_TOKENS=6000
LLM_CLOUD_TOKEN_PARAMETER=max_completion_tokens
LLM_CLOUD_REASONING_EFFORT=
LLM_CLOUD_TIMEOUT=1800
TRANSCRIPT_CHUNK_BYTES=12000
WORKER_REDELIVER_TIMEOUT=86400
